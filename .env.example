# ============================================================================
# MARKETOS v4 — VARIABLES DE ENTORNO CONFIGURABLES
# ============================================================================

# Supabase Public API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# PostgreSQL Transaction Pooler URL (Puerto 6543 para Next.js / Serverless)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres

# Seguridad de sesiones HMAC (Staff / Super Admin)
AUTH_SESSION_SECRET=<generate-at-least-32-random-bytes-hex>

# Cloudflare R2 Storage (S3 API)
R2_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=marketos-media
R2_PUBLIC_DOMAIN=https://assets.<your-domain>

# Configuración Multi-Tenant / Portal (FASE 11.5 - Zero Hardcodes)
# Deja vacío en modo SaaS Multi-Tenant para mostrar el directorio de comercios en "/"
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=
NEXT_PUBLIC_PLATFORM_DOMAIN=marketos.app
NEXT_PUBLIC_SERVER_IPV4=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DEFAULT_PRIMARY_COLOR=#18181B
NEXT_PUBLIC_DEFAULT_SECONDARY_COLOR=#09090B
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#FFFFFF
